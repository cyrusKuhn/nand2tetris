// File name: projects/1/DMux4Way.hdl
/**
 * 4-way demultiplexor:
 * [a, b, c, d] = [in, 0, 0, 0] if sel = 00
 *                [0, in, 0, 0] if sel = 01
 *                [0, 0, in, 0] if sel = 10
 *                [0, 0, 0, in] if sel = 11
 */
CHIP DMux4Way {
    IN in, sel[2];
    OUT a, b, c, d;

    PARTS:
    Not(in=sel[0], out=notsel0);
    Not(in=sel[1], out=notsel1);
    
    And(a=notsel0, b=notsel1, out=aon);
    And(a=sel[0], b=notsel1, out=bon);
    And(a=notsel0, b=sel[1], out=con);
    And(a=sel[0], b=sel[1], out=don);

    And(a=in, b=aon, out=a);
    And(a=in, b=bon, out=b);
    And(a=in, b=con, out=c);
    And(a=in, b=don, out=d);
}