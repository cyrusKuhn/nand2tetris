// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16],inc, load, reset;
    OUT out[16];
    
    PARTS:
    Register(in=newvalue, load=true, out=pastvalue);

    DFF(in=reset, out=resetpast);
    DFF(in=load, out=loadpast);
    DFF(in=inc, out=incpast);
    Register(in=in, load=true, out=inpast);

    Inc16(in=pastvalue, out=pastvalueinc);

    Mux16(a=pastvalue, b=pastvalueinc, sel=incpast, out=intermediate1);
    Mux16(a=intermediate1, b=inpast, sel=loadpast, out=intermediate2);
    Mux16(a=intermediate2, sel=resetpast, out=newvalue);

    And16(a=newvalue, b=newvalue, out=out);
}
